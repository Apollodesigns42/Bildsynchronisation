# Zugangsdaten für die Import-Skripte (auf dem PC, an dem die Festplatte hängt).
# Kopieren nach import.env und ausfüllen. import.env wird nicht ins Git eingecheckt.

# Adresse des Servers
IMMICH_SERVER=https://fotos.example.de

# API-Schlüssel: Immich-Weboberfläche → Profilbild → Kontoeinstellungen → API-Schlüssel → Neuer API-Schlüssel
IMMICH_API_KEY=
