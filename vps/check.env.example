# Einstellungen für vps/check.sh – kopieren nach vps/check.env und ausfüllen (wird nicht eingecheckt).
# Dieselben Mail-Zugangsdaten wie in heimserver/check.env auf dem Mini-PC.
SMTP_URL=smtp://mail.gmx.net:587
SMTP_USER=name@example.de
SMTP_PASS=
MAIL_FROM=name@example.de
MAIL_TO=name@example.de

# Alternativ oder zusätzlich: Push-Nachricht über ntfy, z.B. dasselbe Thema wie bei Uptime Kuma.
# Mail-Daten oben dann einfach auf name@example.de lassen, wenn nur ntfy genutzt werden soll.
NTFY_URL=
# Nur nötig, wenn das ntfy-Thema geschützt ist
NTFY_TOKEN=

# Burgenkampf-Server lokal auf dem VPS (jede HTTP-Antwort zählt als „läuft“)
BURGENKAMPF_URL=http://127.0.0.1:8571

# Grenzwerte
DISK_WARN_PERCENT=85
MEM_WARN_FREE_PERCENT=10

# An diesem Wochentag auch ohne Probleme eine „Alles ok“-Mail (1 = Montag … 7 = Sonntag, leer = nie)
OK_MAIL_WEEKDAY=1
