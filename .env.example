# Kopiervorlage – wird von scripts/install.sh nach .env kopiert und ausgefüllt.
# Alle Variablen: https://docs.immich.app/install/environment-variables

# Öffentliche Domain des Servers (muss per DNS auf den VPS zeigen), z.B. fotos.example.de
DOMAIN=fotos.example.de

# Speicherort der Fotos/Videos auf dem VPS (viel Platz einplanen!)
UPLOAD_LOCATION=./library

# Speicherort der Datenbank (lokale Platte/SSD, kein Netzlaufwerk)
DB_DATA_LOCATION=./postgres

# Zeitzone
TZ=Europe/Berlin

# Immich-Version. "v3" = immer die neueste 3.x-Version; für feste Version z.B. "v3.3.5"
IMMICH_VERSION=v3

# Datenbank-Passwort – nur A-Za-z0-9, wird von install.sh zufällig erzeugt
DB_PASSWORD=postgres

# Ab hier muss normalerweise nichts geändert werden
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
