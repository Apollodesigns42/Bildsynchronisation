# Kopiervorlage – wird von install.sh nach .env kopiert und ausgefüllt.

# Domain für Mealie (DNS-A-Eintrag auf den VPS), z.B. rezepte.example.de
MEALIE_DOMAIN=rezepte.example.de

# Speicherort (Datenbank + Rezeptbilder, klein → System-SSD)
MEALIE_DATA_DIR=./data

# Mealie-Version: https://github.com/mealie-recipes/mealie/releases
MEALIE_VERSION=v3.30.0
