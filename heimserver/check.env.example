# Einstellungen für check.sh – kopieren nach check.env und ausfüllen (wird nicht eingecheckt).

# --- E-Mail-Versand (beliebiger Mail-Anbieter mit SMTP) ---
# GMX:      smtp://mail.gmx.net:587       (in den GMX-Einstellungen „POP3/IMAP-Abruf“ erlauben)
# Web.de:   smtp://smtp.web.de:587
# Gmail:    smtp://smtp.gmail.com:587     (App-Passwort nötig)
# Ist bei deinem Konto die Zwei-Faktor-Anmeldung aktiv, hier ein App-Passwort verwenden.
SMTP_URL=smtp://mail.gmx.net:587
SMTP_USER=name@example.de
SMTP_PASS=
MAIL_FROM=name@example.de
MAIL_TO=name@example.de

# --- Prüfungen ---
# Öffentliche Adresse der Fotos. Prüft die ganze Kette: Internet → VPS → Tunnel → Mini-PC.
# Die Cloud-Adresse wird automatisch aus cloud/.env gelesen.
PHOTOS_URL=https://fotos.example.de

# Warnung ab dieser Belegung der Festplatten (Prozent)
DISK_WARN_PERCENT=85

# Warnung, wenn das letzte erfolgreiche Backup älter ist (Stunden)
BACKUP_MAX_AGE_HOURS=30

# An diesem Wochentag kommt auch ohne Probleme eine „Alles ok“-Mail – so merkst du,
# falls der Check selbst nicht mehr läuft. 1 = Montag … 7 = Sonntag, leer = nie.
OK_MAIL_WEEKDAY=1
