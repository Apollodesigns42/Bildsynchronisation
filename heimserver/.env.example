# Kopiervorlage – wird von install.sh nach .env kopiert und ausgefüllt.
# Alle Variablen: https://docs.immich.app/install/environment-variables

# Speicherort der Fotos/Videos auf dem Mini-PC (z.B. die zweite Platte: /mnt/daten/fotos)
UPLOAD_LOCATION=./library

# Speicherort der Vorschaubilder (ca. 2–3 % der Fotosammlung). Standard: auf der System-SSD,
# damit die Zeitleiste auch dann flott lädt, wenn die Originale auf einer Festplatte liegen.
# Nachträglich ändern nur zusammen mit dem Inhalt (inkl. der versteckten Datei .immich) verschieben.
THUMB_LOCATION=./thumbs

# Speicherort der Datenbank (lokale Platte/SSD, kein Netzlaufwerk)
DB_DATA_LOCATION=./postgres

# Zeitzone
TZ=Europe/Berlin

# Immich-Version. "v3" = immer die neueste 3.x-Version; für feste Version z.B. "v3.3.5"
IMMICH_VERSION=v3

# Datenbank-Passwort – nur A-Za-z0-9, wird von install.sh zufällig erzeugt
DB_PASSWORD=postgres

# Ab hier muss normalerweise nichts geändert werden
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
