# Kopiervorlage – wird von install.sh nach .env kopiert und ausgefüllt.

# Domain für den Passwortmanager (DNS-A-Eintrag auf den VPS), z.B. passwort.example.de
VAULTWARDEN_DOMAIN=passwort.example.de

# Speicherort (klein → System-SSD)
VAULTWARDEN_DATA_DIR=./data

# Registrierung neuer Konten: nur zum Einrichten auf true, danach false
# (./registrierung.sh an | aus)
VAULTWARDEN_SIGNUPS_ALLOWED=false
