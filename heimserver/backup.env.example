# Einstellungen für backup.sh – kopieren nach backup.env (wird nicht eingecheckt).

# Ziel des verschlüsselten Backups (restic-Repository).
# "storagebox" ist der Kurzname aus /root/.ssh/config (siehe README).
RESTIC_REPOSITORY=sftp:storagebox:/home/restic

# Datei mit dem Backup-Passwort – wird von "backup.sh init" erzeugt.
# OHNE DIESES PASSWORT IST DAS BACKUP WERTLOS. Zusätzlich im Passwortmanager speichern!
RESTIC_PASSWORD_FILE=/root/.restic-passwort

# Upload-Begrenzung in KiB/s (leer = unbegrenzt). 1500 ≈ 12 Mbit/s, lässt bei 20 Mbit/s Upload Luft.
BWLIMIT=1500

# Aufbewahrung: so viele tägliche/wöchentliche/monatliche Stände bleiben erhalten
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
