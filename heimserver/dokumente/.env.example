# Kopiervorlage – wird von install.sh nach .env kopiert und ausgefüllt.

# Domain der Dokumentenverwaltung (DNS-A-Eintrag auf den VPS), z.B. www.example.eu
PAPERLESS_DOMAIN=dokumente.example.de

# Speicherorte
# Datenbank, Suchindex und Eingangsordner → System-SSD (relativ zu diesem Ordner)
PAPERLESS_DB_DIR=./db
PAPERLESS_DATA_DIR=./data
PAPERLESS_CONSUME_DIR=./eingang
# Die Dokumente selbst → Daten-Platte (z.B. /mnt/daten/dokumente)
PAPERLESS_MEDIA_DIR=./dokumente

# Zusatzdienste, durch Komma getrennt:
#   scanner = Scannen per Browser über den Netzwerk-Scanner (SCANNER_URL unten setzen)
#   office  = Word-/Excel-/E-Mail-Dateien verarbeiten (ca. 1 GB RAM mehr; dann auch PAPERLESS_TIKA_ENABLED=1)
COMPOSE_PROFILES=scanner
PAPERLESS_TIKA_ENABLED=0

# Netzwerk-Scanner (eSCL/AirScan) als http://<IP>:<Port>. Feste IP in der FritzBox vergeben!
# Test: docker exec scanservjs scanimage -d escl:$SCANNER_URL -A
SCANNER_URL=http://192.168.178.50:80

# Werden von install.sh zufällig erzeugt
PAPERLESS_SECRET_KEY=
PAPERLESS_DB_PASSWORD=
# Passwort für den Benutzer "admin" – gilt nur für den allerersten Start
PAPERLESS_ADMIN_PASSWORD=
