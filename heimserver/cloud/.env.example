# Kopiervorlage – wird von install.sh nach .env kopiert und ausgefüllt.

# Domain der Cloud (DNS-A-Eintrag auf den VPS), z.B. cloud.example.de
OC_DOMAIN=cloud.example.de

# Speicherorte (gehören dem Benutzer 1000:1000, wird von install.sh eingerichtet).
# Die Daten am besten auf die große SSD legen.
OC_CONFIG_DIR=./config
OC_DATA_DIR=./daten

# OpenCloud-Version. "7" = immer die neueste 7.x-Version
OC_VERSION=7

# Passwort für den Benutzer "admin" – wird von install.sh zufällig erzeugt.
# Gilt nur für den allerersten Start; danach in der Weboberfläche ändern.
INITIAL_ADMIN_PASSWORD=
